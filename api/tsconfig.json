{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "@/*": ["./src/*"]
        },

        "module": "commonjs",
        "target": "ES2022",

        "types": ["node", "jest"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        "strict": false,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "allowJs": true
    },
    "include": ["src/**/*.ts", "src/infra/database/config/config.js"],
    "exclude": ["node_modules", "dist"]
}
