{
    "name": "api",
    "version": "1.0.0",
    "description": "",
    "homepage": "https://github.com/sabrineR/back-to-the-future#readme",
    "bugs": {
        "url": "https://github.com/sabrineR/back-to-the-future/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sabrineR/back-to-the-future.git"
    },
    "license": "ISC",
    "author": "Sabrine BEN SASSI",
    "type": "commonjs",
    "main": "index.ts",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "migrate": "sequelize-cli db:migrate",
        "migrate:undo": "sequelize-cli db:migrate:undo",
        "seed": "sequelize-cli db:seed:all",
        "seed:undo": "sequelize-cli db:seed:undo:all",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "jest"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1130.0",
        "@aws-sdk/s3-request-presigner": "^3.1130.0",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.3.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "joi": "^18.2.8",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "sequelize": "^6.37.8",
        "sequelize-typescript": "^2.1.6",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.4.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.5.1",
        "prettier": "^3.9.6",
        "sequelize-cli": "^6.6.5",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.9.4",
        "tsconfig-paths": "^4.2.0",
        "typescript": "6.0",
        "typescript-eslint": "^8.69.0"
    }
}
